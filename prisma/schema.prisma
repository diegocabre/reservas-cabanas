// Esquema de Reservas Cabañas Sur.
//
// Convenciones:
// - Tablas y columnas en snake_case en Postgres (@@map / @map); en TypeScript quedan en camelCase.
// - Montos en CLP como enteros (Int). Nunca Float ni Decimal.
// - Fechas de estadía y rangos como `date` (@db.Date), sin hora.
// - TODOS los rangos de fechas son semiabiertos [desde, hasta): el último día es EXCLUSIVO.
//   Aplica a Reserva (check_in, check_out), Temporada (desde, hasta) y Bloqueo (desde, hasta),
//   igual que DTEND en iCal. Siempre hasta > desde (check en la migración).
// - La restricción anti doble reserva (exclude using gist) y los checks de rangos viven en una
//   migración escrita a mano, porque Prisma no los soporta en el schema.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolAdmin {
  dueno
  staff

  @@map("rol_admin")
}

enum EstadoReserva {
  pendiente_pago
  confirmada
  cancelada
  completada
  pendiente_aprobacion // solicitud: el dueño debe aprobarla (cabana.requiere_aprobacion)
  aprobada_pendiente_pago // aprobada: el huésped tiene el link de pago hasta expira_en
  rechazada
  expirada // el dueño no respondió o el huésped no pagó a tiempo

  @@map("estado_reserva")
}

enum OrigenReserva {
  web
  airbnb
  booking
  manual

  @@map("origen_reserva")
}

enum ProveedorPago {
  mercadopago
  flow
  transferencia
  efectivo

  @@map("proveedor_pago")
}

enum EstadoPago {
  pendiente
  aprobado
  rechazado

  @@map("estado_pago")
}

// Acciones del panel que quedan en la auditoría.
enum AccionAuditoria {
  confirmar
  cancelar
  registrar_pago
  marcar_revisado
  crear_bloqueo
  eliminar_bloqueo
  conectar_mercadopago
  desconectar_mercadopago
  aprobar
  rechazar
  nuevo_link_pago
  configurar_cabana

  @@map("accion_auditoria")
}

enum OrigenBloqueo {
  manual
  ical

  @@map("origen_bloqueo")
}

enum Plataforma {
  airbnb
  booking

  @@map("plataforma")
}

model Propiedad {
  id                   String       @id @default(uuid()) @db.Uuid
  nombre               String
  slug                 String       @unique
  ubicacion            String? // texto libre, ej. "Puerto Varas · Lago Llanquihue"
  urlMapa              String?      @map("url_mapa") // link de Google Maps a la propiedad
  prefijoCodigo        String       @unique @default("RES") @map("prefijo_codigo") // códigos de reserva "LL-7K3QX9AB"
  ultimoCorrelativo    Int          @default(0) @map("ultimo_correlativo") // en desuso: los códigos ya no son correlativos
  whatsapp             String
  email                String
  abonoPct             Int          @default(50) @map("abono_pct") // abono = % del total (si abono_noches es null)
  abonoNoches          Int?         @map("abono_noches") // abono = N noches de la tarifa de la estadía (piloto: 1), con tope en el total
  politicaCancelacion  String?      @map("politica_cancelacion")
  instruccionesLlegada String?      @map("instrucciones_llegada")
  tema                 Json? // colores propios de la propiedad (lib/tema.ts); null = paleta base
  // Plataforma (/admin/plataforma, solo superadmin). Suspendida (por falta de pago): no aparece en el
  // sitio, no recibe reservas y sus admins no entran al panel.
  suspendida           Boolean      @default(false)
  suspendidaEn         DateTime?    @map("suspendida_en") @db.Timestamptz(3)
  suspendidaPor        String?      @map("suspendida_por") // email del superadmin
  resenas              EtapaResenas @default(apagadas) // reseñas activas en esta propiedad (docs/plan-resenas.md)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  admins         Admin[]
  cabanas        Cabana[]
  cuentaPago     CuentaMercadoPago?
  auditoria      Auditoria[]
  resenasHuesped ResenaHuesped[]

  @@map("propiedad")
}

// Acceso de un usuario de Supabase Auth a una propiedad. Un usuario puede administrar varias
// propiedades (una fila por propiedad); cada consulta del panel filtra por ellas (ver lib/panel-acceso.ts).
model Admin {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid // id del usuario de Supabase Auth (auth.users.id)
  propiedadId String   @map("propiedad_id") @db.Uuid
  email       String
  rol         RolAdmin @default(dueno)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  propiedad Propiedad @relation(fields: [propiedadId], references: [id])

  @@unique([usuarioId, propiedadId])
  @@index([propiedadId])
  @@map("admin")
}

model Cabana {
  id                       String   @id @default(uuid()) @db.Uuid
  propiedadId              String   @map("propiedad_id") @db.Uuid
  nombre                   String
  slug                     String
  capacidad                Int
  dormitorios              Int
  descripcion              String   @default("")
  servicios                String[] @default([])
  fotos                    String[] @default([])
  minNoches                Int      @default(1) @map("min_noches") // estadía mínima de la cabaña
  activa                   Boolean  @default(true)
  demo                     Boolean  @default(false) // cabaña de demostración (datos de ejemplo, no es un alojamiento real)
  // Aprobación manual: las reservas web nacen como solicitud (pendiente_aprobacion) y se cobran al aprobarlas.
  requiereAprobacion       Boolean  @default(false) @map("requiere_aprobacion")
  horasRespuestaAprobacion Int      @default(24) @map("horas_respuesta_aprobacion") // plazo del dueño para responder
  horasParaPagar           Int      @default(24) @map("horas_para_pagar") // vigencia del link de pago al aprobar
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  propiedad           Propiedad           @relation(fields: [propiedadId], references: [id])
  temporadas          Temporada[] // sin uso desde el piloto (precios fijos por Tarifa); queda para la etapa 2
  tarifas             Tarifa[]
  reservas            Reserva[]
  bloqueos            Bloqueo[]
  auditoria           Auditoria[]
  calendariosExternos CalendarioExterno[]
  resenas             ResenaCabana[]

  @@unique([propiedadId, slug])
  @@map("cabana")
}

model Temporada {
  id          String   @id @default(uuid()) @db.Uuid
  cabanaId    String   @map("cabana_id") @db.Uuid
  nombre      String
  desde       DateTime @db.Date // inclusivo
  hasta       DateTime @db.Date // EXCLUSIVO: [desde, hasta)
  precioNoche Int      @map("precio_noche")
  minNoches   Int?     @map("min_noches") // si es null, rige cabana.min_noches

  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Cascade)

  @@index([cabanaId, desde])
  @@map("temporada")
}

// Precio por noche según cantidad de personas y largo de la estadía, fijo todo el año.
// Para una estadía se usa la fila de la cabaña con personas_desde <= personas <= personas_hasta y el
// mayor noches_desde <= noches; ese precio se cobra en TODAS las noches (ver lib/precios.ts).
model Tarifa {
  id            String @id @default(uuid()) @db.Uuid
  cabanaId      String @map("cabana_id") @db.Uuid
  personasDesde Int    @map("personas_desde") // inclusivo
  personasHasta Int    @map("personas_hasta") // inclusivo
  nochesDesde   Int    @map("noches_desde") // desde cuántas noches rige este precio
  precioNoche   Int    @map("precio_noche")

  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Cascade)

  @@unique([cabanaId, personasDesde, nochesDesde])
  @@map("tarifa")
}

model Reserva {
  id                    String        @id @default(uuid()) @db.Uuid
  codigo                String        @unique // prefijo de la propiedad + 8 caracteres aleatorios, ej. LL-7K3QX9AB (antes 6: LL-7K3QX9; y LL-0001)
  cabanaId              String        @map("cabana_id") @db.Uuid
  checkIn               DateTime      @map("check_in") @db.Date // inclusivo
  checkOut              DateTime      @map("check_out") @db.Date // EXCLUSIVO: ese día queda libre para otra llegada
  adultos               Int
  ninos                 Int           @default(0)
  huespedNombre         String        @map("huesped_nombre")
  huespedEmail          String        @map("huesped_email")
  huespedTelefono       String        @map("huesped_telefono")
  huespedRut            String?       @map("huesped_rut") // obligatorio en reservas web; puede faltar en las de Airbnb/Booking/manuales
  total                 Int
  abono                 Int
  estado                EstadoReserva @default(pendiente_pago)
  origen                OrigenReserva @default(web)
  expiraEn              DateTime?     @map("expira_en") @db.Timestamptz(3) // plazo para pagar, o para que el dueño responda una solicitud
  notas                 String? // texto libre (del huésped o del dueño): nunca se interpreta
  esPrueba              Boolean       @default(false) @map("es_prueba") // creada en modo prueba: sin "[Prueba]" en notas
  revisarPago           Boolean       @default(false) @map("revisar_pago") // pago que no se pudo aplicar solo (lib/mercadopago.ts)
  revisarPagoMotivo     String?       @map("revisar_pago_motivo") // una línea por pago; se conserva al marcarlo revisado
  // Solicitudes (cabana.requiere_aprobacion). Ver lib/aprobacion.ts.
  aprobadaEn            DateTime?     @map("aprobada_en") @db.Timestamptz(3)
  linkPago              String?       @map("link_pago") // link de Mercado Pago creado al aprobar; solo lo ven el huésped y el dueño
  linkPagoExpiraEn      DateTime?     @map("link_pago_expira_en") @db.Timestamptz(3)
  whatsappAbiertoEn     DateTime?     @map("whatsapp_abierto_en") @db.Timestamptz(3) // el dueño abrió WhatsApp (no implica entregado)
  recordatorioDuenoEn   DateTime?     @map("recordatorio_dueno_en") @db.Timestamptz(3)
  recordatorioHuespedEn DateTime?     @map("recordatorio_huesped_en") @db.Timestamptz(3)
  expiracionAvisadaEn   DateTime?     @map("expiracion_avisada_en") @db.Timestamptz(3)
  avisoFallido          String?       @map("aviso_fallido") // último aviso que no se pudo enviar, para mostrarlo en el panel
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Reseñas (lib/resenas.ts). Opcional: lo llenan el script de poblado y el cron de reseñas.
  huespedId             String?       @map("huesped_id") @db.Uuid

  cabana        Cabana         @relation(fields: [cabanaId], references: [id])
  huesped       Huesped?       @relation(fields: [huespedId], references: [id], onDelete: SetNull)
  pagos         Pago[]
  auditoria     Auditoria[]
  cicloResena   CicloResena?
  resenaCabana  ResenaCabana?
  resenaHuesped ResenaHuesped?

  @@index([cabanaId, checkIn])
  @@index([estado, expiraEn])
  @@index([huespedId])
  @@map("reserva")
}

model Pago {
  id         String        @id @default(uuid()) @db.Uuid
  reservaId  String        @map("reserva_id") @db.Uuid
  proveedor  ProveedorPago
  monto      Int
  estado     EstadoPago    @default(pendiente)
  refExterna String?       @map("ref_externa")
  pagadoEn   DateTime?     @map("pagado_en") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  reserva Reserva @relation(fields: [reservaId], references: [id])

  // Un pago externo (ej. id de pago de Mercado Pago) se registra una sola vez aunque el aviso llegue repetido.
  @@unique([proveedor, refExterna])
  @@index([reservaId])
  @@map("pago")
}

// Registro de cada cambio que hace un admin en el panel: quién, cuándo y qué. Solo se agrega:
// el rol del panel puede insertar y leer, nunca editar ni borrar (ver las migraciones).
// Cambios de una reserva: reserva_id. Bloqueos: cabana_id y bloqueo_id (sin FK: el registro queda
// aunque el bloqueo se elimine).
model Auditoria {
  id            String          @id @default(uuid()) @db.Uuid
  reservaId     String?         @map("reserva_id") @db.Uuid
  cabanaId      String?         @map("cabana_id") @db.Uuid
  propiedadId   String?         @map("propiedad_id") @db.Uuid // cambios de la propiedad (cuenta de Mercado Pago)
  bloqueoId     String?         @map("bloqueo_id") @db.Uuid
  usuarioId     String          @map("usuario_id") @db.Uuid // usuario de Supabase Auth que hizo el cambio
  email         String // email del admin en ese momento
  accion        AccionAuditoria
  estadoAntes   EstadoReserva?  @map("estado_antes")
  estadoDespues EstadoReserva?  @map("estado_despues")
  detalle       String? // motivo de cancelación, monto y medio del pago, fechas del bloqueo, etc.
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  reserva   Reserva?   @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  cabana    Cabana?    @relation(fields: [cabanaId], references: [id], onDelete: Cascade)
  propiedad Propiedad? @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([reservaId, createdAt])
  @@index([cabanaId, createdAt])
  @@index([propiedadId, createdAt])
  @@index([bloqueoId])
  @@map("auditoria")
}

// Cuenta de Mercado Pago conectada por el dueño (OAuth): los abonos se cobran con ella y el dinero
// llega a su cuenta. Tokens cifrados (lib/cifrado.ts). RLS sin políticas y SIN permisos para
// panel_admin: solo el servidor (postgres) los lee, después de verificar al admin.
model CuentaMercadoPago {
  id                  String   @id @default(uuid()) @db.Uuid
  propiedadId         String   @unique @map("propiedad_id") @db.Uuid
  mpUserId            String   @map("mp_user_id") // id del vendedor en Mercado Pago (llega en los avisos)
  accessTokenCifrado  String   @map("access_token_cifrado")
  refreshTokenCifrado String   @map("refresh_token_cifrado")
  publicKey           String?  @map("public_key")
  expiraEn            DateTime @map("expira_en") @db.Timestamptz(3)
  produccion          Boolean // false: credenciales de prueba
  conectadaPor        String   @map("conectada_por") // email del admin que la conectó
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([mpUserId])
  @@map("cuenta_mercadopago")
}

model Bloqueo {
  id         String        @id @default(uuid()) @db.Uuid
  cabanaId   String        @map("cabana_id") @db.Uuid
  desde      DateTime      @db.Date // inclusivo
  hasta      DateTime      @db.Date // EXCLUSIVO: [desde, hasta), igual que DTEND en iCal
  motivo     String?
  origen     OrigenBloqueo @default(manual)
  uidExterno String?       @map("uid_externo") // UID del evento iCal
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Cascade)

  @@unique([cabanaId, uidExterno])
  @@index([cabanaId, desde])
  @@map("bloqueo")
}

model CalendarioExterno {
  id         String     @id @default(uuid()) @db.Uuid
  cabanaId   String     @map("cabana_id") @db.Uuid
  plataforma Plataforma
  urlIcal    String     @map("url_ical")
  ultimoSync DateTime?  @map("ultimo_sync") @db.Timestamptz(3)

  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Cascade)

  @@unique([cabanaId, plataforma])
  @@map("calendario_externo")
}

// ---------------------------------------------------------------------------------------------
// Reseñas (docs/plan-resenas.md). Doble ciego: ninguna reseña de una reserva se muestra a la otra
// parte (ni al público) hasta que ambas escribieron la suya o pasaron 14 días desde el check-out.
// ---------------------------------------------------------------------------------------------

// Reseñas activas por propiedad: la elige el superadmin en /admin/plataforma.
enum EtapaResenas {
  apagadas
  cabana // reseñas de la cabaña (públicas)
  completas // además las reseñas privadas del huésped

  @@map("etapa_resenas")
}

enum EstadoResena {
  retenida // esperando el doble ciego: solo la ve su autor
  publicada
  oculta // la ocultó el superadmin por un reporte: se conserva pero no se muestra

  @@map("estado_resena")
}

enum CalificacionHuesped {
  recomendado
  con_reservas
  no_recomendado

  @@map("calificacion_huesped")
}

enum MotivoReporte {
  insultos
  datos_personales
  no_corresponde

  @@map("motivo_reporte")
}

enum EstadoModeracion {
  pendiente
  aceptado // reporte: la reseña se ocultó. Solicitud de privacidad: atendida
  descartado

  @@map("estado_moderacion")
}

enum TipoSolicitudPrivacidad {
  rectificacion
  eliminacion

  @@map("tipo_solicitud_privacidad")
}

// Huésped identificado por email normalizado (minúsculas, sin espacios), para que su historial lo
// siga entre reservas. El teléfono (+569XXXXXXXX) es secundario: dos huéspedes pueden compartirlo.
model Huesped {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique // normalizado (lib/huespedes.ts)
  telefono         String? // normalizado, +569XXXXXXXX
  nombrePila       String    @map("nombre_pila")
  // Link de acceso a sus datos (Ley 21.719): HMAC con versión, guardado como hash, vence en 24 h.
  accesoVersion    Int       @default(0) @map("acceso_version")
  accesoHash       String?   @unique @map("acceso_hash")
  accesoExpiraEn   DateTime? @map("acceso_expira_en") @db.Timestamptz(3)
  accesoPedidoEn   DateTime? @map("acceso_pedido_en") @db.Timestamptz(3) // límite: un link cada 10 minutos
  creadoPorPoblado Boolean   @default(false) @map("creado_por_poblado") // para revertir el script de poblado
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  reservas    Reserva[]
  resenas     ResenaHuesped[]
  solicitudes SolicitudPrivacidad[]

  @@index([telefono])
  @@map("huesped")
}

// Ciclo de reseñas de una reserva elegible (confirmada con check-out pasado): invitación al
// huésped, recordatorios y el desbloqueo del doble ciego. Lo crea el cron de reseñas.
model CicloResena {
  id                  String    @id @default(uuid()) @db.Uuid
  reservaId           String    @unique @map("reserva_id") @db.Uuid
  // Token de la invitación: HMAC(RESENAS_SECRETO, id:versión). Se guarda solo su hash; usarlo sube
  // la versión, así cada link sirve una sola vez.
  tokenVersion        Int       @default(0) @map("token_version")
  tokenHash           String    @unique @map("token_hash")
  tokenExpiraEn       DateTime  @map("token_expira_en") @db.Timestamptz(3) // check-out + 30 días
  invitacionEnviadaEn DateTime? @map("invitacion_enviada_en") @db.Timestamptz(3)
  recordatorioEn      DateTime? @map("recordatorio_en") @db.Timestamptz(3)
  whatsappAbiertoEn   DateTime? @map("whatsapp_abierto_en") @db.Timestamptz(3) // el dueño abrió WhatsApp (no implica entregado)
  recordatorioDuenoEn DateTime? @map("recordatorio_dueno_en") @db.Timestamptz(3)
  desbloqueadoEn      DateTime? @map("desbloqueado_en") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  reserva Reserva @relation(fields: [reservaId], references: [id], onDelete: Cascade)

  @@index([desbloqueadoEn])
  @@map("ciclo_resena")
}

// Reseña de la cabaña escrita por el huésped. Pública cuando está "publicada". Sin email, teléfono
// ni apellido: solo el nombre de pila (nombre_publico).
model ResenaCabana {
  id            String       @id @default(uuid()) @db.Uuid
  reservaId     String       @unique @map("reserva_id") @db.Uuid
  cabanaId      String       @map("cabana_id") @db.Uuid
  nombrePublico String       @map("nombre_publico")
  limpieza      Int
  ubicacion     Int
  comunicacion  Int
  veracidad     Int
  calidadPrecio Int          @map("calidad_precio")
  comentario    String
  estado        EstadoResena @default(retenida)
  ediciones     Int          @default(0)
  publicadaEn   DateTime?    @map("publicada_en") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  reserva   Reserva          @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  cabana    Cabana           @relation(fields: [cabanaId], references: [id], onDelete: Cascade)
  respuesta RespuestaResena?
  reportes  ReporteResena[]

  @@index([cabanaId, estado, publicadaEn])
  @@map("resena_cabana")
}

// Respuesta pública del dueño a una reseña (una por reseña, editable por un plazo).
model RespuestaResena {
  id             String   @id @default(uuid()) @db.Uuid
  resenaId       String   @unique @map("resena_id") @db.Uuid
  texto          String
  autorUsuarioId String   @map("autor_usuario_id") @db.Uuid
  autorEmail     String   @map("autor_email")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  resena ResenaCabana @relation(fields: [resenaId], references: [id], onDelete: Cascade)

  @@map("respuesta_resena")
}

// Reporte de una reseña por el dueño: llega a la cola del superadmin, que puede ocultarla.
model ReporteResena {
  id          String           @id @default(uuid()) @db.Uuid
  resenaId    String           @map("resena_id") @db.Uuid
  motivo      MotivoReporte
  detalle     String?
  estado      EstadoModeracion @default(pendiente)
  usuarioId   String           @map("usuario_id") @db.Uuid
  email       String
  resueltoPor String?          @map("resuelto_por") // email del superadmin
  resueltoEn  DateTime?        @map("resuelto_en") @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  resena ResenaCabana @relation(fields: [resenaId], references: [id], onDelete: Cascade)

  @@index([estado, createdAt])
  @@index([resenaId])
  @@map("reporte_resena")
}

// Reseña PRIVADA del huésped escrita por el dueño. La ven solo los admins de la propiedad autora
// (y el huésped, por su link de acceso, después del desbloqueo). Ver la vista reputacion_compartida.
model ResenaHuesped {
  id             String              @id @default(uuid()) @db.Uuid
  reservaId      String              @unique @map("reserva_id") @db.Uuid
  propiedadId    String              @map("propiedad_id") @db.Uuid
  huespedId      String              @map("huesped_id") @db.Uuid
  autorUsuarioId String              @map("autor_usuario_id") @db.Uuid
  autorEmail     String              @map("autor_email")
  calificacion   CalificacionHuesped
  etiquetas      String[]            @default([])
  comentario     String?
  estado         EstadoResena        @default(retenida)
  publicadaEn    DateTime?           @map("publicada_en") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  reserva   Reserva         @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  propiedad Propiedad       @relation(fields: [propiedadId], references: [id], onDelete: Cascade)
  huesped   Huesped         @relation(fields: [huespedId], references: [id], onDelete: Cascade)
  replica   ReplicaHuesped?

  @@index([huespedId, estado])
  @@index([propiedadId])
  @@map("resena_huesped")
}

// Réplica del huésped a una reseña sobre él (se muestra junto a la reseña a los dueños autorizados).
model ReplicaHuesped {
  id        String   @id @default(uuid()) @db.Uuid
  resenaId  String   @unique @map("resena_id") @db.Uuid
  texto     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  resena ResenaHuesped @relation(fields: [resenaId], references: [id], onDelete: Cascade)

  @@map("replica_huesped")
}

// Solicitud de rectificación o eliminación del huésped: llega a la cola de moderación. Nada se
// borra automáticamente.
model SolicitudPrivacidad {
  id          String                  @id @default(uuid()) @db.Uuid
  huespedId   String                  @map("huesped_id") @db.Uuid
  tipo        TipoSolicitudPrivacidad
  mensaje     String
  estado      EstadoModeracion        @default(pendiente)
  resueltoPor String?                 @map("resuelto_por")
  resueltoEn  DateTime?               @map("resuelto_en") @db.Timestamptz(3)
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)

  huesped Huesped @relation(fields: [huespedId], references: [id], onDelete: Cascade)

  @@index([estado, createdAt])
  @@map("solicitud_privacidad")
}

// Configuración de la plataforma (una sola fila, id = 1).
model ConfiguracionPlataforma {
  id                  Int     @id @default(1)
  compartirReputacion Boolean @default(false) @map("compartir_reputacion") // reputación del huésped entre dueños: APAGADA

  @@map("configuracion_plataforma")
}

// Administradores de la plataforma (Soluciones DyS): moderan reportes y solicitudes de privacidad.
model Superadmin {
  usuarioId String   @id @map("usuario_id") @db.Uuid
  email     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("superadmin")
}

// Intentos en rutas públicas, para limitar abusos (lib/limites.ts). La clave es un HMAC con sal de la
// IP, el email o el teléfono: nunca se guardan en claro (Ley 21.719). El cron borra los antiguos.
model IntentoPublico {
  id       BigInt   @id @default(autoincrement())
  accion   String
  clave    String
  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@index([accion, clave, creadoEn])
  @@index([creadoEn])
  @@map("intentos_publicos")
}
