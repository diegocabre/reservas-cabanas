// Esquema de Reservas Cabañas Sur.
//
// Convenciones:
// - Tablas y columnas en snake_case en Postgres (@@map / @map); en TypeScript quedan en camelCase.
// - Montos en CLP como enteros (Int). Nunca Float ni Decimal.
// - Fechas de estadía y rangos como `date` (@db.Date), sin hora.
// - TODOS los rangos de fechas son semiabiertos [desde, hasta): el último día es EXCLUSIVO.
//   Aplica a Reserva (check_in, check_out), Temporada (desde, hasta) y Bloqueo (desde, hasta),
//   igual que DTEND en iCal. Siempre hasta > desde (check en la migración).
// - La restricción anti doble reserva (exclude using gist) y los checks de rangos viven en una
//   migración escrita a mano, porque Prisma no los soporta en el schema.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RolAdmin {
  dueno
  staff

  @@map("rol_admin")
}

enum EstadoReserva {
  pendiente_pago
  confirmada
  cancelada
  completada
  pendiente_aprobacion // solicitud: el dueño debe aprobarla (cabana.requiere_aprobacion)
  aprobada_pendiente_pago // aprobada: el huésped tiene el link de pago hasta expira_en
  rechazada
  expirada // el dueño no respondió o el huésped no pagó a tiempo

  @@map("estado_reserva")
}

enum OrigenReserva {
  web
  airbnb
  booking
  manual

  @@map("origen_reserva")
}

enum ProveedorPago {
  mercadopago
  flow
  transferencia
  efectivo

  @@map("proveedor_pago")
}

enum EstadoPago {
  pendiente
  aprobado
  rechazado

  @@map("estado_pago")
}

// Acciones del panel que quedan en la auditoría.
enum AccionAuditoria {
  confirmar
  cancelar
  registrar_pago
  marcar_revisado
  crear_bloqueo
  eliminar_bloqueo
  conectar_mercadopago
  desconectar_mercadopago
  aprobar
  rechazar
  nuevo_link_pago
  configurar_cabana

  @@map("accion_auditoria")
}

enum OrigenBloqueo {
  manual
  ical

  @@map("origen_bloqueo")
}

enum Plataforma {
  airbnb
  booking

  @@map("plataforma")
}

model Propiedad {
  id                   String   @id @default(uuid()) @db.Uuid
  nombre               String
  slug                 String   @unique
  ubicacion            String? // texto libre, ej. "Puerto Varas · Lago Llanquihue"
  urlMapa              String?  @map("url_mapa") // link de Google Maps a la propiedad
  prefijoCodigo        String   @unique @default("RES") @map("prefijo_codigo") // códigos de reserva "LL-7K3QX9"
  ultimoCorrelativo    Int      @default(0) @map("ultimo_correlativo") // en desuso: los códigos ya no son correlativos
  whatsapp             String
  email                String
  abonoPct             Int      @default(50) @map("abono_pct") // abono = % del total (si abono_noches es null)
  abonoNoches          Int?     @map("abono_noches") // abono = N noches de la tarifa de la estadía (piloto: 1), con tope en el total
  politicaCancelacion  String?  @map("politica_cancelacion")
  instruccionesLlegada String?  @map("instrucciones_llegada")
  tema                 Json? // colores propios de la propiedad (lib/tema.ts); null = paleta base
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  admins     Admin[]
  cabanas    Cabana[]
  cuentaPago CuentaMercadoPago?
  auditoria  Auditoria[]

  @@map("propiedad")
}

// Acceso de un usuario de Supabase Auth a una propiedad. Un usuario puede administrar varias
// propiedades (una fila por propiedad); cada consulta del panel filtra por ellas (ver lib/panel-acceso.ts).
model Admin {
  id          String   @id @default(uuid()) @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid // id del usuario de Supabase Auth (auth.users.id)
  propiedadId String   @map("propiedad_id") @db.Uuid
  email       String
  rol         RolAdmin @default(dueno)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  propiedad Propiedad @relation(fields: [propiedadId], references: [id])

  @@unique([usuarioId, propiedadId])
  @@index([propiedadId])
  @@map("admin")
}

model Cabana {
  id          String   @id @default(uuid()) @db.Uuid
  propiedadId String   @map("propiedad_id") @db.Uuid
  nombre      String
  slug        String
  capacidad   Int
  dormitorios Int
  descripcion String   @default("")
  servicios   String[] @default([])
  fotos       String[] @default([])
  minNoches   Int      @default(1) @map("min_noches") // estadía mínima de la cabaña
  activa      Boolean  @default(true)
  demo        Boolean  @default(false) // cabaña de demostración (datos de ejemplo, no es un alojamiento real)
  // Aprobación manual: las reservas web nacen como solicitud (pendiente_aprobacion) y se cobran al aprobarlas.
  requiereAprobacion       Boolean @default(false) @map("requiere_aprobacion")
  horasRespuestaAprobacion Int     @default(24) @map("horas_respuesta_aprobacion") // plazo del dueño para responder
  horasParaPagar           Int     @default(24) @map("horas_para_pagar") // vigencia del link de pago al aprobar
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  propiedad           Propiedad           @relation(fields: [propiedadId], references: [id])
  temporadas          Temporada[] // sin uso desde el piloto (precios fijos por Tarifa); queda para la etapa 2
  tarifas             Tarifa[]
  reservas            Reserva[]
  bloqueos            Bloqueo[]
  auditoria           Auditoria[]
  calendariosExternos CalendarioExterno[]

  @@unique([propiedadId, slug])
  @@map("cabana")
}

model Temporada {
  id          String   @id @default(uuid()) @db.Uuid
  cabanaId    String   @map("cabana_id") @db.Uuid
  nombre      String
  desde       DateTime @db.Date // inclusivo
  hasta       DateTime @db.Date // EXCLUSIVO: [desde, hasta)
  precioNoche Int      @map("precio_noche")
  minNoches   Int?     @map("min_noches") // si es null, rige cabana.min_noches

  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Cascade)

  @@index([cabanaId, desde])
  @@map("temporada")
}

// Precio por noche según cantidad de personas y largo de la estadía, fijo todo el año.
// Para una estadía se usa la fila de la cabaña con personas_desde <= personas <= personas_hasta y el
// mayor noches_desde <= noches; ese precio se cobra en TODAS las noches (ver lib/precios.ts).
model Tarifa {
  id            String @id @default(uuid()) @db.Uuid
  cabanaId      String @map("cabana_id") @db.Uuid
  personasDesde Int    @map("personas_desde") // inclusivo
  personasHasta Int    @map("personas_hasta") // inclusivo
  nochesDesde   Int    @map("noches_desde") // desde cuántas noches rige este precio
  precioNoche   Int    @map("precio_noche")

  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Cascade)

  @@unique([cabanaId, personasDesde, nochesDesde])
  @@map("tarifa")
}

model Reserva {
  id              String        @id @default(uuid()) @db.Uuid
  codigo          String        @unique // prefijo de la propiedad + 6 caracteres aleatorios, ej. LL-7K3QX9 (los antiguos: LL-0001)
  cabanaId        String        @map("cabana_id") @db.Uuid
  checkIn         DateTime      @map("check_in") @db.Date // inclusivo
  checkOut        DateTime      @map("check_out") @db.Date // EXCLUSIVO: ese día queda libre para otra llegada
  adultos         Int
  ninos           Int           @default(0)
  huespedNombre   String        @map("huesped_nombre")
  huespedEmail    String        @map("huesped_email")
  huespedTelefono String        @map("huesped_telefono")
  huespedRut      String?       @map("huesped_rut") // obligatorio en reservas web; puede faltar en las de Airbnb/Booking/manuales
  total           Int
  abono           Int
  estado          EstadoReserva @default(pendiente_pago)
  origen          OrigenReserva @default(web)
  expiraEn        DateTime?     @map("expira_en") @db.Timestamptz(3) // plazo para pagar, o para que el dueño responda una solicitud
  notas           String?
  // Solicitudes (cabana.requiere_aprobacion). Ver lib/aprobacion.ts.
  aprobadaEn            DateTime? @map("aprobada_en") @db.Timestamptz(3)
  linkPago              String?   @map("link_pago") // link de Mercado Pago creado al aprobar; solo lo ven el huésped y el dueño
  linkPagoExpiraEn      DateTime? @map("link_pago_expira_en") @db.Timestamptz(3)
  whatsappAbiertoEn     DateTime? @map("whatsapp_abierto_en") @db.Timestamptz(3) // el dueño abrió WhatsApp (no implica entregado)
  recordatorioDuenoEn   DateTime? @map("recordatorio_dueno_en") @db.Timestamptz(3)
  recordatorioHuespedEn DateTime? @map("recordatorio_huesped_en") @db.Timestamptz(3)
  expiracionAvisadaEn   DateTime? @map("expiracion_avisada_en") @db.Timestamptz(3)
  avisoFallido          String?   @map("aviso_fallido") // último aviso que no se pudo enviar, para mostrarlo en el panel
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  cabana    Cabana      @relation(fields: [cabanaId], references: [id])
  pagos     Pago[]
  auditoria Auditoria[]

  @@index([cabanaId, checkIn])
  @@index([estado, expiraEn])
  @@map("reserva")
}

model Pago {
  id         String        @id @default(uuid()) @db.Uuid
  reservaId  String        @map("reserva_id") @db.Uuid
  proveedor  ProveedorPago
  monto      Int
  estado     EstadoPago    @default(pendiente)
  refExterna String?       @map("ref_externa")
  pagadoEn   DateTime?     @map("pagado_en") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  reserva Reserva @relation(fields: [reservaId], references: [id])

  // Un pago externo (ej. id de pago de Mercado Pago) se registra una sola vez aunque el aviso llegue repetido.
  @@unique([proveedor, refExterna])
  @@index([reservaId])
  @@map("pago")
}

// Registro de cada cambio que hace un admin en el panel: quién, cuándo y qué. Solo se agrega:
// el rol del panel puede insertar y leer, nunca editar ni borrar (ver las migraciones).
// Cambios de una reserva: reserva_id. Bloqueos: cabana_id y bloqueo_id (sin FK: el registro queda
// aunque el bloqueo se elimine).
model Auditoria {
  id            String          @id @default(uuid()) @db.Uuid
  reservaId     String?         @map("reserva_id") @db.Uuid
  cabanaId      String?         @map("cabana_id") @db.Uuid
  propiedadId   String?         @map("propiedad_id") @db.Uuid // cambios de la propiedad (cuenta de Mercado Pago)
  bloqueoId     String?         @map("bloqueo_id") @db.Uuid
  usuarioId     String          @map("usuario_id") @db.Uuid // usuario de Supabase Auth que hizo el cambio
  email         String // email del admin en ese momento
  accion        AccionAuditoria
  estadoAntes   EstadoReserva?  @map("estado_antes")
  estadoDespues EstadoReserva?  @map("estado_despues")
  detalle       String? // motivo de cancelación, monto y medio del pago, fechas del bloqueo, etc.
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  reserva   Reserva?   @relation(fields: [reservaId], references: [id], onDelete: Cascade)
  cabana    Cabana?    @relation(fields: [cabanaId], references: [id], onDelete: Cascade)
  propiedad Propiedad? @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([reservaId, createdAt])
  @@index([cabanaId, createdAt])
  @@index([propiedadId, createdAt])
  @@index([bloqueoId])
  @@map("auditoria")
}

// Cuenta de Mercado Pago conectada por el dueño (OAuth): los abonos se cobran con ella y el dinero
// llega a su cuenta. Tokens cifrados (lib/cifrado.ts). RLS sin políticas y SIN permisos para
// panel_admin: solo el servidor (postgres) los lee, después de verificar al admin.
model CuentaMercadoPago {
  id                  String   @id @default(uuid()) @db.Uuid
  propiedadId         String   @unique @map("propiedad_id") @db.Uuid
  mpUserId            String   @map("mp_user_id") // id del vendedor en Mercado Pago (llega en los avisos)
  accessTokenCifrado  String   @map("access_token_cifrado")
  refreshTokenCifrado String   @map("refresh_token_cifrado")
  publicKey           String?  @map("public_key")
  expiraEn            DateTime @map("expira_en") @db.Timestamptz(3)
  produccion          Boolean // false: credenciales de prueba
  conectadaPor        String   @map("conectada_por") // email del admin que la conectó
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  propiedad Propiedad @relation(fields: [propiedadId], references: [id], onDelete: Cascade)

  @@index([mpUserId])
  @@map("cuenta_mercadopago")
}

model Bloqueo {
  id         String        @id @default(uuid()) @db.Uuid
  cabanaId   String        @map("cabana_id") @db.Uuid
  desde      DateTime      @db.Date // inclusivo
  hasta      DateTime      @db.Date // EXCLUSIVO: [desde, hasta), igual que DTEND en iCal
  motivo     String?
  origen     OrigenBloqueo @default(manual)
  uidExterno String?       @map("uid_externo") // UID del evento iCal
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Cascade)

  @@unique([cabanaId, uidExterno])
  @@index([cabanaId, desde])
  @@map("bloqueo")
}

model CalendarioExterno {
  id         String     @id @default(uuid()) @db.Uuid
  cabanaId   String     @map("cabana_id") @db.Uuid
  plataforma Plataforma
  urlIcal    String     @map("url_ical")
  ultimoSync DateTime?  @map("ultimo_sync") @db.Timestamptz(3)

  cabana Cabana @relation(fields: [cabanaId], references: [id], onDelete: Cascade)

  @@unique([cabanaId, plataforma])
  @@map("calendario_externo")
}
