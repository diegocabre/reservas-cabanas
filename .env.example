# Copia este archivo como .env y completa con los datos de tu proyecto Supabase
# (Project Settings → Database → Connection string).
# Si la contraseña tiene caracteres especiales (? ! $ # / @), codifícalos para URL (ej. ? → %3F).

# Conexión por pooler (Transaction mode, puerto 6543). La usa la app en tiempo de ejecución.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# URL pública del sitio, para metadata y vistas previas de WhatsApp. Opcional:
# si falta, en Vercel se usa VERCEL_PROJECT_PRODUCTION_URL y en local http://localhost:3000.
NEXT_PUBLIC_SITE_URL="https://reservas.tudominio.cl"

# Secreto que Vercel envía al llamar al cron (/api/cron/expirar-reservas). Cualquier texto largo y aleatorio.
# Configúralo también en Vercel → Settings → Environment Variables.
CRON_SECRET="genera-un-texto-largo-y-aleatorio"

# Mercado Pago (Checkout Pro). Access Token de la pestaña "Prueba" para sandbox.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
# Opcional: clave secreta de Webhooks (Mercado Pago Developers → Webhooks) para validar la firma de los avisos.
MERCADOPAGO_WEBHOOK_SECRET=""

# Conexión por pooler en Session mode (puerto 5432). La usa Prisma para migraciones.
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth (login del panel con link mágico). Project Settings → API keys, del MISMO proyecto
# que DATABASE_URL. La llave anónima es pública: con RLS sin políticas no lee ninguna tabla.
NEXT_PUBLIC_SUPABASE_URL="https://<ref-del-proyecto>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Llave secreta (service_role). SOLO para `npm run admin:registrar` en local; nunca en Vercel ni en la app.
SUPABASE_SERVICE_ROLE_KEY=""

# Conexión de la cuenta de Mercado Pago de cada propiedad (OAuth). Aplicación de Soluciones DyS en
# Mercado Pago Developers → Tus integraciones → Credenciales. La URL de redirección registrada en la
# aplicación debe ser https://<tu-dominio>/admin/mercadopago/conectado.
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
# Clave para cifrar los tokens de los dueños en la base: 32 bytes aleatorios en base64.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, cada dueño tiene que volver a conectar su cuenta.
MERCADOPAGO_CLAVE_CIFRADO=""

# Modo prueba: activo por defecto (avisos visibles y reservas marcadas [PRUEBA]).
# Ponlo en false solo cuando el sitio deba cobrar de verdad.
RESERVAS_MODO_PRUEBA=true

# Emails con Resend (resend.com → API Keys). Sin esta llave no se envían emails: solo queda un aviso en la consola.
RESEND_API_KEY=
# Opcional: dirección remitente, de un dominio verificado en Resend. Por defecto: reservas@reservas.solucionesdys.cl
EMAIL_REMITENTE=

# Reseñas (docs/plan-resenas.md): se activan por propiedad en /admin/plataforma (superadmin).
# Secreto para firmar los links de reseña y de "Mis datos" (32+ caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si cambia, los links ya enviados dejan de servir.
RESENAS_SECRETO=

# Límites anti abuso en rutas públicas (lib/limites.ts, docs/endurecimiento.md).
# Sal para guardar IP, email y teléfono como hash (nunca en claro) y firmar la marca anti-bot.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si falta, se deriva de otro secreto del servidor (funciona, pero conviene definirla).
LIMITES_SECRETO=
# Opcionales: umbrales (valores por defecto entre paréntesis).
# LIMITE_PENDIENTES_POR_CONTACTO=2   reservas pendientes por email y por teléfono en una cabaña
# LIMITE_RESERVAS_IP_HORA=10         reservas web por IP por hora
# LIMITE_CORREOS_DESTINO_DIA=3       correos por destinatario por día desde acciones públicas
# RESERVAS_MAX_NOCHES=30             noches máximas de una reserva web
# LIMITE_CONSULTAS_IP_HORA=30        búsquedas, reseñas, mis datos, pago y verificación por IP por hora
# LIMITE_BUSQUEDAS_CODIGO_HORA=10    búsquedas fallidas por código de reserva por hora
# LIMITE_NO_ENCONTRADAS_IP_HORA=20   páginas de reserva no encontradas por IP por hora
# LIMITE_LINKS_IP_HORA=10            pedidos de link (panel, mis datos) por IP por hora

# Despliegue gradual de pagos (docs/endurecimiento.md). Por defecto false = comportamiento anterior.
# true, fuera del modo prueba: el webhook rechaza (401) avisos sin MERCADOPAGO_WEBHOOK_SECRET o con
# firma inválida, e ignora avisos de un user_id que no es una cuenta conectada.
# Activar solo después de revisar unos días los logs "webhook_firma_invalida".
MERCADOPAGO_WEBHOOK_STRICT=false
# true: regla explícita de la cuenta que cobra. Con cuenta conectada, el pago debe cobrarlo esa cuenta;
# sin cuenta, solo la cuenta de la plataforma y solo en modo prueba. Lo que no cumpla queda [REVISAR PAGO]
# y se avisa por correo a los superadmins.
MERCADOPAGO_COBRO_ESTRICTO=false
